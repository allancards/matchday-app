  // prisma/schema.prisma
  generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client" 
  }


  datasource db {
    provider = "postgresql"
    }


  // ⭐ Jogador (NÃO tem login, é cadastrado pelo Admin)
  model Player {
    id         String   @id @default(cuid())
    name       String   // Nome do amigo
    position   String // Goleiro, Zagueiro, etc.
    photoUrl   String?  // Avatar opcional (UploadThing)
    isActive   Boolean  @default(true) // Para esconder quem saiu do time
    createdAt  DateTime @default(now())

    attendances Attendance[]
    goals       Goal[]
    assists     Goal[]        @relation("Assist")
  }

  // Evento = A Pelada
  model Event {
    id          String   @id @default(cuid())
    title       String   // Ex: "Pelada do Domingo"
    description String?  // "No campo do Zé, 16h"
    date        DateTime // Quando vai rolar
    location    String?  // Endereço
    createdAt   DateTime @default(now())

    createdById String   // Quem criou (User)
    createdBy   User     @relation(fields: [createdById], references: [id])

    attendances Attendance[]
    goals       Goal[]
  }

  // Confirmação de Presença
  model Attendance {
    id        String   @id @default(cuid())
    status    String   // GOING, NOT_GOING, MAYBE
    createdAt DateTime @default(now())

    eventId   String
    event     Event    @relation(fields: [eventId], references: [id])

    playerId  String
    player    Player   @relation(fields: [playerId], references: [id])

    @@unique([eventId, playerId]) // Um jogador só confirma 1x por evento
  }

  // Gols marcados no dia
  model Goal {
    id        String   @id @default(cuid())
    minute    Int?     // Minuto do gol (opcional)
    createdAt DateTime @default(now())

    eventId   String
    event     Event    @relation(fields: [eventId], references: [id])

    playerId  String   // Quem fez o gol
    player    Player   @relation(fields: [playerId], references: [id])

    assistId  String?  // Quem deu a assistência (opcional)
    assist    Player?  @relation("Assist", fields: [assistId], references: [id])
  }

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  emailVerified DateTime? //
  image     String?
  createdAt DateTime @default(now())

  events    Event[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}